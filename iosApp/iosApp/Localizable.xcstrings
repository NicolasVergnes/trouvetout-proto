        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Import terminé"
          }
        }
      }
    },
    "settings_import_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore or merge an export: known entries are skipped, nothing is overwritten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurer ou fusionner un export : ce qui est déjà connu est ignoré, rien n'est écrasé."
          }
        }
      }
    },
    "settings_import_refused_invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This export is damaged or incomplete."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet export est abîmé ou incomplet."
          }
        }
      }
    },
    "settings_import_refused_newer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This export comes from a newer version of the app. Update the app, then try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet export vient d'une version plus récente de l'app. Mettez l'app à jour puis réessayez."
          }
        }
      }
    },
    "settings_import_refused_not_archive": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file is not a TrouveTout export."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
