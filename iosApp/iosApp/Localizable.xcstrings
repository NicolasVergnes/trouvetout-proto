    },
    "camera_denied_text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app may not use the camera. You can allow it in the iPhone Settings, or pick a photo from your library instead."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app n’a pas accès à l’appareil photo. Vous pouvez l’autoriser dans les Réglages de l’iPhone, ou choisir une photo de votre photothèque."
          }
        }
      }
    },
    "camera_denied_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera not allowed"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appareil photo non autorisé"
          }
        }
      }
    },
    "camera_rationale_text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To photograph an object or a place, or to find an object from a photo. The photo stays in the app, on this iPhone: never in your library, never online. iOS will now ask for your permission."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour photographier un objet ou un lieu, ou retrouver un objet à partir d’une photo. La photo reste dans l’app, sur cet iPhone : ni dans votre photothèque, ni sur internet. iOS va maintenant vous demander l’autorisation."
          }
        }
      }
    },
    "camera_rationale_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the camera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser l’appareil photo"
          }
        }
      }
    },
