    },
    "settings_import_hint" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Restore or merge an export: known entries are skipped, nothing is overwritten." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Restaurer ou fusionner un export : ce qui est déjà connu est ignoré, rien n'est écrasé." } }
