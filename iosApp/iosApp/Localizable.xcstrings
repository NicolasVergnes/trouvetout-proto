        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Export prêt" } }
      }
    },
    "settings_export_hint" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Export everything (objects, places, photos) as a ZIP file you can read without the app, and share it where you like. Nothing is sent anywhere by itself." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Exporter tout (objets, lieux, photos) dans un fichier ZIP lisible sans l'app, et le partager où vous voulez. Rien n'est envoyé tout seul." } }
      }
    },
    "settings_export_share" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Share the last export" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Partager le dernier export" } }
      }
    },
    "settings_failed_text" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The operation could not be completed. Check the free space on the phone and try again." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "L'opération n'a pas pu aboutir. Vérifiez l'espace libre du téléphone et réessayez." } }
      }
    },
    "settings_failed_title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Something went wrong" } },
