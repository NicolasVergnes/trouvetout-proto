          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorti"
          }
        }
      }
    },
    "state_unknown_place": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No place yet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans lieu pour l'instant"
          }
        }
      }
    },
    "storage_unavailable_text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app could not prepare its private storage on this phone. Free some space or restart the phone, then open the app again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app n'a pas pu préparer son espace privé sur ce téléphone. Libérez de la place ou redémarrez le téléphone, puis rouvrez l'app."
          }
        }
      }
    },
    "storage_unavailable_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage unavailable"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockage indisponible"
          }
        }
      }
    },
    "store_key_lost_text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key that protects them on this iPhone was erased. Nobody can open them any more, the app neither. Erase the data to start again, then import an export if you have one."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé qui les protège sur cet iPhone a été effacée. Plus personne ne peut les ouvrir, pas même l’app. Effacez les données pour repartir, puis importez un export si vous en avez un."
          }
        }
      }
    },
    "store_key_lost_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your objects cannot be read"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos objets ne peuvent pas être lus"
          }
        }
      }
    },
    "voice_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictation did not work. Try again, or type."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dictée n’a pas fonctionné. Réessayez, ou tapez."
          }
        }
      }
    },
    "voice_no_match": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing heard. Try again, or type."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien entendu. Réessayez, ou tapez."
          }
        }
      }
    },
    "voice_no_recognizer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone has no speech recognition for this language. Type your sentence instead."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone n’a pas de reconnaissance vocale pour cette langue. Tapez votre phrase."
          }
        }
      }
    },
    "voice_not_on_device": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline dictation is not available for this language on this iPhone, so the microphone is off. Type your sentence instead."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dictée hors ligne n’est pas disponible pour cette langue sur cet iPhone : le micro est désactivé. Tapez votre phrase."
          }
        }
      }
    },
    "voice_permission_denied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone or speech recognition is not allowed. You can allow them in Settings, or type your sentence."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro ou la reconnaissance vocale n’est pas autorisé. Vous pouvez les autoriser dans Réglages, ou taper votre phrase."
          }
        }
      }
    },
    "voice_rationale_text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TrouveTout turns your sentence into text on this phone. The audio never leaves the device and is not kept."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TrouveTout transforme votre phrase en texte sur ce téléphone. Le son ne quitte jamais l’appareil et n’est pas conservé."
          }
        }
      }
    },
    "voice_rationale_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the microphone?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser le micro ?"
          }
        }
      }
    },
    "welcome_ask": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Later, ask “where is the passport?”: the answer is a place, with the date."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus tard, demandez « où est le passeport ? » : la réponse est un lieu, avec la date."
          }
        }
      }
    },
    "welcome_dismiss": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Got it"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compris"
          }
        }
      }
    },
    "welcome_places": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can start from a set of places (house, flat…), or create them as you go: nothing is imposed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez partir d’un modèle de lieux (maison, appartement…) ou les créer au fil de l’eau : rien n’est imposé."
          }
        }
      }
    },
    "welcome_places_action": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See the place sets"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voir les modèles de lieux"
          }
        }
      }
    },
    "welcome_private": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays on this phone: no account, nothing is sent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste sur ce téléphone : pas de compte, rien n’est envoyé."
          }
        }
      }
    },
    "welcome_say": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say or type where you put something: “passport in the top drawer of the dresser”. Nothing to set up first."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites ou tapez où vous posez un objet : « passeport dans le tiroir du haut de la commode ». Rien à configurer avant."
          }
        }
      }
    },
    "welcome_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First steps"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour commencer"
          }
        }
      }
    }
  },
  "version": "1.0"
}
