    "settings_export_done_text" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%d entries and %d photos. Use Share to send the file where you like." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "%d entrées et %d photos. Utilisez Partager pour envoyer le fichier où vous voulez." } }
