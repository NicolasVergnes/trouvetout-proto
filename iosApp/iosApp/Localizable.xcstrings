          }
        }
      }
    },
    "settings_wipe": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase all data"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout effacer"
          }
        }
      }
    },
    "settings_wipe_confirm_button": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer"
          }
        }
      }
    },
    "settings_wipe_confirm_text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Objects, places, photos and history will be deleted from this phone. Export first if you want to keep them. This cannot be undone. The start date of the free trial stays on this phone, in its keychain, even if you uninstall the app. What has already left the app is not erased: exports, PDFs, the phone's notification history, and the backup file in the folder you chose (unreadable without its key)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Objets, lieux, photos et historique seront supprimés de ce téléphone. Exportez d'abord si vous voulez les garder. Cette action est irréversible. La date de début de l'essai gratuit reste sur ce téléphone, dans son trousseau, même si vous désinstallez l'application. Ce qui est déjà sorti de l'app n'est pas effacé : exports, PDF, historique des notifications du téléphone, et le fichier de sauvegarde dans le dossier que vous avez choisi (illisible sans sa clé)."
          }
        }
      }
    },
    "settings_wipe_confirm_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase all data?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout effacer ?"
          }
        }
      }
    },
    "settings_wipe_done_text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app starts from scratch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app repart de zéro."
          }
        }
      }
    },
    "settings_wipe_done_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data erased"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données effacées"
          }
        }
      }
    },
    "settings_wipe_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase every piece of data stored by the app on this phone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer toutes les données enregistrées par l'app sur ce téléphone."
          }
        }
      }
    },
