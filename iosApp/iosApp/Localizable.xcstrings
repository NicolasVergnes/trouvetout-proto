    "settings_export_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export everything (objects, places, photos) as a ZIP file you can read without the app, and share it where you like. Nothing is sent anywhere by itself. The file is not encrypted and contains everything, including items marked sensitive and photos: share it with care."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporter tout (objets, lieux, photos) dans un fichier ZIP lisible sans l'app, et le partager où vous voulez. Rien n'est envoyé tout seul. Le fichier n'est pas chiffré et contient tout, y compris les objets marqués sensibles et les photos : partagez-le avec soin."
          }
        }
      }
    },
    "settings_export_share": {
