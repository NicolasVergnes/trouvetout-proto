    "reminder_permission_text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So that your reminders can reach you, the phone asks whether this app may show notifications. They name the object at most, never its place. On the lock screen the phone shows only “TrouveTout reminder”, unless you chose to always show previews."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour que vos rappels vous parviennent, le téléphone demande si l'app peut afficher des notifications. Elles nomment l'objet au plus, jamais son lieu. Sur l'écran verrouillé, le téléphone n'en montre que « Rappel TrouveTout », sauf si vous avez choisi d'afficher toujours les aperçus."
          }
        }
      }
    },
    "reminder_permission_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications?"
