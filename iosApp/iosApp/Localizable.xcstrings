    "settings_export_done_text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%ld entries and %ld photos. Use Share to send the file where you like."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%ld entrées et %ld photos. Utilisez Partager pour envoyer le fichier où vous voulez."
          }
        }
      }
    },
    "settings_export_done_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export ready"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Export prêt"
          }
        }
      }
    },
    "settings_export_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export everything (objects, places, photos) as a ZIP file you can read without the app, and share it where you like. Nothing is sent anywhere by itself. The file is not encrypted and contains everything, including items marked sensitive and photos: share it with care."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporter tout (objets, lieux, photos) dans un fichier ZIP lisible sans l'app, et le partager où vous voulez. Rien n'est envoyé tout seul. Le fichier n'est pas chiffré et contient tout, y compris les objets marqués sensibles et les photos : partagez-le avec soin."
          }
        }
      }
    },
    "settings_export_share": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share the last export"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partager le dernier export"
          }
        }
      }
    },
    "settings_failed_text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation could not be completed. Check the free space on the phone and try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'opération n'a pas pu aboutir. Vérifiez l'espace libre du téléphone et réessayez."
          }
        }
      }
    },
    "settings_failed_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose s'est mal passé"
          }
        }
      }
    },
    "settings_import": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import an export"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer un export"
          }
        }
      }
    },
