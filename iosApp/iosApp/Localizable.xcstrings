        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nommer les objets d’après une photo demande un iPhone de 6 Go de mémoire. Les photos restent ajoutées aux objets et la recherche fonctionne avec des mots."
          }
        }
      }
    },
    "settings_photos_model": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name objects from their photo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nommer les objets d’après leur photo"
          }
        }
      }
    },
    "settings_photos_model_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turned off, the app uses less memory; photos are still added to objects."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, l’app utilise moins de mémoire ; les photos restent ajoutées aux objets."
          }
        }
      }
    },
    "settings_photos_search": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search with a photo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chercher avec une photo"
          }
        }
      }
    },
    "settings_photos_search_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs “Name objects from their photo”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite « Nommer les objets d’après leur photo »."
          }
        }
      }
    },
    "settings_photos_section": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos"
          }
        }
      }
    },
    "settings_photos_stopped": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last time, the photo model did not fit in the phone’s free memory and the app closed: naming objects from their photo was turned off. Turn it on to try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière fois, le modèle photo n’a pas tenu dans la mémoire libre du téléphone et l’app s’est fermée : le nommage d’après la photo a été désactivé. Réactivez-le pour réessayer."
          }
        }
      }
    },
    "settings_photos_text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this iPhone, photos are understood by a second model included in the app: it suggests a name for a photographed object and finds objects from a photo. Everything stays on the iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur cet iPhone, un second modèle inclus dans l’app comprend les photos : il propose un nom pour un objet photographié et retrouve des objets à partir d’une photo. Tout reste sur l’iPhone."
          }
        }
      }
    },
    "settings_privacy_section": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vie privée"
          }
        }
      }
    },
    "settings_purchase_section": {
