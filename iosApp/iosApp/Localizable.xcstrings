          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer"
          }
        }
      }
    },
    "settings_wipe_confirm_text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Objects, places, photos and history will be deleted from this phone. Export first if you want to keep them. This cannot be undone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Objets, lieux, photos et historique seront supprimés de ce téléphone. Exportez d'abord si vous voulez les garder. Cette action est irréversible."
          }
        }
      }
    },
    "settings_wipe_confirm_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase all data?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout effacer ?"
          }
        }
      }
    },
    "settings_wipe_done_text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app starts from scratch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app repart de zéro."
          }
        }
      }
    },
    "settings_wipe_done_title": {
      "localizations": {
        "en": {
