    "settings_search_text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search runs on this phone: keywords, synonyms and the meaning of words, with a model included in the app. Nothing is sent anywhere."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche tourne sur ce téléphone : mots-clés, synonymes et sens des mots, avec un modèle inclus dans l’app. Rien n’est envoyé nulle part."
          }
        }
      }
    },
    "settings_simple_mode": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simplified mode"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode simplifié"
          }
        }
      }
    },
    "settings_simple_mode_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The home screen shows two large buttons only: put something away, find it. The settings stay at the top."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accueil ne montre que deux grands boutons : ranger, retrouver. Les réglages restent en haut."
          }
        }
      }
    },
    "settings_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        },
        "fr": {
