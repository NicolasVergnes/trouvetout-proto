{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To photograph an object or a place, or to find an object from a photo. Photos stay in the app, on this device: never in your photo library, never online."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour photographier un objet ou un lieu, ou retrouver un objet à partir d'une photo. Les photos restent dans l'application, sur votre téléphone : ni dans votre galerie, ni sur internet."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To unlock the app and show sensitive objects, when you turn on the app lock. Face ID data never leaves the iPhone and the app never sees it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour déverrouiller l’app et afficher les objets sensibles, quand vous activez le verrouillage. Les données Face ID ne quittent jamais l’iPhone et l’app ne les voit pas."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To turn the sentence you say into text, on this phone. The audio never leaves the device and is not kept."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour transformer la phrase que vous dites en texte, sur ce téléphone. Le son ne quitte jamais l’appareil et n’est pas conservé."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sentence is recognised on this phone only, never by a server, then turned into an object and a place."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre phrase est reconnue sur ce téléphone uniquement, jamais par un serveur, puis transformée en objet et en lieu."
          }
        }
      }
    }
  },
  "version": "1.0"
}
