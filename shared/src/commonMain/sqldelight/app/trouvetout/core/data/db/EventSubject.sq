-- Index des sujets d'un événement (objet, lieu, contenant...) pour l'historique par fiche (A5).
CREATE TABLE event_subject (
  event_id TEXT NOT NULL,
  subject_type TEXT NOT NULL,
  subject_id TEXT NOT NULL,
  PRIMARY KEY (event_id, subject_type, subject_id)
);

CREATE INDEX event_subject_lookup ON event_subject(subject_type, subject_id);

insert:
INSERT OR IGNORE INTO event_subject(event_id, subject_type, subject_id) VALUES (?, ?, ?);

eventsFor:
SELECT e.id, e.at, e.device_id, e.actor, e.type, e.payload, e.source, e.raw_input
FROM event e
JOIN event_subject s ON s.event_id = e.id
WHERE s.subject_type = ? AND s.subject_id = ?
ORDER BY e.at, e.device_id, e.id;
